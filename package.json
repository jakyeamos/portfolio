{
  "name": "front-office-amos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "predev": "pnpm sync",
    "prebuild": "pnpm sync",
    "prelint": "pnpm sync",
    "sync": "node scripts/sync-tracker.mjs",
    "shot-embeds": "node scripts/check-shot-embeds.mjs",
    "shot-embeds:target": "node scripts/check-shot-embeds.mjs --target=50",
    "shot-inventory": "node scripts/check-shot-embeds.mjs --inventory",
    "deploy:status": "node scripts/netlify-deploy-status.mjs",
    "netlify:cli": "node scripts/netlify-cli.mjs",
    "netlify:status": "node scripts/netlify-cli.mjs status",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:content && pnpm shot-inventory",
    "test:content": "node scripts/check-project-content.mjs",
    "precr:check": "pnpm test:content && pnpm lint && pnpm build",
    "env:check": "node scripts/validate-env.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "pnpm audit --audit-level high",
    "e2e:smoke": "pnpm shot-embeds:target"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "netlify-cli": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
