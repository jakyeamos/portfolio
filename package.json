{
  "name": "front-office-amos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "pnpm shot-clips:check && pnpm demo-content:check && vite build && pnpm generate:project-pages",
    "generate:project-pages": "node scripts/generate-project-pages.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "tracker:sync": "node scripts/sync-tracker.mjs --write",
    "tracker:check": "node scripts/sync-tracker.mjs --check",
    "tracker:weekly": "node scripts/weekly-tracker-main-refresh.mjs",
    "deploy:status": "node scripts/netlify-deploy-status.mjs",
    "netlify:cli": "node scripts/netlify-cli.mjs",
    "netlify:status": "node scripts/netlify-cli.mjs status",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:content",
    "test:content": "node scripts/check-easter-egg-content.mjs && node scripts/check-easter-egg-engine.mjs && node scripts/check-project-content.mjs && node scripts/check-shot-clips.mjs && node scripts/check-demo-content.mjs && node scripts/check-blog-content.mjs && node scripts/check-internal-routes.mjs",
    "demo-content:check": "node scripts/check-demo-content.mjs",
    "shot-clips:check": "node scripts/check-shot-clips.mjs",
    "audit:dead-code": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "precr:check": "pnpm test:content && pnpm lint && pnpm build",
    "env:check": "node scripts/validate-env.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "dependency:security": "node scripts/dependency-security.mjs",
    "test:e2e": "playwright test",
    "e2e:smoke": "playwright test --project=desktop",
    "smoke": "pnpm e2e:smoke"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "netlify-cli": "^26.1.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
